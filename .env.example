# 1. PostgreSQL / Supabase Database Connection URI
# Example from Supabase: Project Settings -> Database -> Connection string (URI) -> Transaction/Session Mode
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. JSON Web Token (JWT) Secret Key for secure session cookies
# Generate a strong 32+ character random string
JWT_SECRET=kisan_saarthi_super_secure_jwt_secret_key_2026_smart_kopargaon

# 3. Fast2SMS API Key for real farmer mobile price alert SMS dispatch
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 4. Agmarknet / Data.gov.in Mandi Market Price API Key
VITE_DATA_GOV_API_KEY=579b464db66ec23bdd0000013b9ed8ac1ba748f069c4ff76e57ab86f

# 5. Google Gemini API Key for AI Search Grounded Crop Price Fallback
GEMINI_API_KEY=your_gemini_api_key_here
CROP_PRICE_STALENESS_HOURS=24

# 6. Resend API Key for Working Email Price Alerts
RESEND_API_KEY=re_your_resend_api_key_here

# 7. Backend SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
