# ====================================================================
# Kisan Saarthi (किसान सारथी) - Environment Configuration
# ====================================================================
#
# SECURITY NOTE: every variable below is SERVER-SIDE ONLY and is read by the
# serverless functions in api/. Do NOT prefix any of them with VITE_ - Vite
# inlines VITE_* variables into the browser bundle, where any visitor can read
# them. Secrets belong in your Vercel project settings, never in this file with
# real values and never committed.

# 1. PostgreSQL / Supabase Database Connection URI
# Example from Supabase: Project Settings -> Database -> Connection string (URI) -> Transaction/Session Mode
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. JSON Web Token (JWT) Secret Key for secure session cookies
# REQUIRED in production - the app refuses to start without it and there is no
# built-in default. Minimum 32 characters. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In local development this may be left blank: a random per-process secret is
# generated automatically (logins are then reset on every dev-server restart).
JWT_SECRET=

# 3. Fast2SMS API Key for real farmer mobile price alert SMS dispatch
# Used only by api/fast2sms.js on the server. Leave blank to disable cloud SMS -
# the app then falls back to sending via the phone's own SIM.
FAST2SMS_API_KEY=

# 4. Agmarknet / Data.gov.in Mandi Market Price API Key (free at data.gov.in)
# Used only by api/agmarknet.js on the server. Farmers may also supply their own
# key in the app's API Key modal, which is stored in their browser only.
DATA_GOV_IN_API_KEY=

# 5. Extra browser origins allowed to call the API (comma-separated, scheme included)
# Same-origin requests and Vercel's own deployment URLs are always allowed, so
# this is only needed for custom domains or a separately hosted frontend.
# Credentialed (auth) routes and the SMS/email routes accept ONLY these origins;
# public read-only price routes are open to any origin without credentials.
ALLOWED_ORIGINS=

# 6. Google Gemini API Key for AI Search Grounded Crop Price Fallback
GEMINI_API_KEY=
CROP_PRICE_STALENESS_HOURS=24

# 7. Resend API Key for Working Email Price Alerts
RESEND_API_KEY=

# 8. Backend SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=
SMTP_FROM="किसान सारथी (Kisan Saarthi)" <alerts@kisansarthi.com>
